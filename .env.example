# ==============================================================================
# FloodWheel Environment Configuration
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=floodwheel-super-secret-development-key-change-in-production

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=floodwheel-admin-jwt-secret-key-change-in-prod
ADMIN_TOKEN_EXPIRE_HOURS=24

# Gemini Vision AI
# Get API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma/space separated list of multiple keys for automatic rotation & 429 failover
GEMINI_API_KEYS=key_1,key_2,key_3
# Optional: Custom API endpoint / proxy URL (e.g., https://my-custom-proxy.internal or https://generativelanguage.googleapis.com)
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Safe pacing interval in seconds (6.0s = max 10 RPM, safely below 15 RPM free tier limit)
GEMINI_MIN_CALL_INTERVAL_SECONDS=6.0

# Automated Background Analysis Queue
FLOOD_QUEUE_INTERVAL_MINUTES=30
FLOOD_QUEUE_AUTO_START=true
FLOOD_QUEUE_MAX_CAMERAS_PER_CYCLE=15

# Smart Analysis Cache TTL in minutes (reuses recent readings to save quota)
FLOOD_ANALYSIS_CACHE_MINUTES=5

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CAMERA_BACKEND_URL=http://camera-backend:8001
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=floodwheel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/floodwheel

# Redis Cache & Message Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend & Maps
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
NEXT_PUBLIC_DEFAULT_CITY=hcmc
NEXT_PUBLIC_DEFAULT_LAT=10.7769
NEXT_PUBLIC_DEFAULT_LNG=106.7009
